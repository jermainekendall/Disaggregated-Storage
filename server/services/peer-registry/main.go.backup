// Peer Registry Service - Complete Fresh Implementation
// File: main.go

package main

import (
	"context"
	"database/sql"
	"fmt"
	"log"
	"net"
	"os"
	"time"

	_ "github.com/lib/pq"
	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/reflection"
	"google.golang.org/grpc/status"
	
	pb "github.com/orchestrator/peer-registry/proto/peer"
)

type Config struct {
	DBHost           string
	DBPort           string
	DBName           string
	DBUser           string
	DBPassword       string
	GRPCPort         string
	HeartbeatTimeout int
}

func loadConfig() *Config {
	return &Config{
		DBHost:           getEnv("DB_HOST", "cockroachdb-public"),
		DBPort:           getEnv("DB_PORT", "26257"),
		DBName:           getEnv("DB_NAME", "orchestrator"),
		DBUser:           getEnv("DB_USER", "root"),
		DBPassword:       getEnv("DB_PASSWORD", ""),
		GRPCPort:         getEnv("GRPC_PORT", "50051"),
		HeartbeatTimeout: 900, // 15 minutes
	}
}

func getEnv(key, defaultValue string) string {
	if value := os.Getenv(key); value != "" {
		return value
	}
	return defaultValue
}

type PeerRegistryServer struct {
	pb.UnimplementedPeerRegistryServer
	db     *sql.DB
	config *Config
}

// RegisterPeer registers or updates a peer
func (s *PeerRegistryServer) RegisterPeer(ctx context.Context, req *pb.PeerRegistration) (*pb.RegistrationResponse, error) {
	log.Printf("RegisterPeer called for peer: %s", req.PeerId)

	now := time.Now()
	query := `
		INSERT INTO peers (
			peer_id, asn, region,
			storage_total_gb, storage_free_gb,
			is_online, health_score, first_seen_at, last_seen_at, last_heartbeat_at
		) VALUES ($1, $2, $3, $4, $5, true, 100.0, $6, $6, $6)
		ON CONFLICT (peer_id) DO UPDATE SET
			asn = $2,
			region = $3,
			storage_total_gb = $4,
			storage_free_gb = $5,
			is_online = true,
			last_seen_at = $6,
			last_heartbeat_at = $6
	`

	_, err := s.db.ExecContext(ctx, query,
		req.PeerId, req.Asn, req.Region,
		req.TotalCapacityBytes/1073741824,
		req.AvailableCapacityBytes/1073741824,
		now,
	)

	if err != nil {
		return &pb.RegistrationResponse{
			Success: false,
			Message: fmt.Sprintf("Failed to register: %v", err),
		}, status.Errorf(codes.Internal, "database error: %v", err)
	}

	log.Printf("Registered peer: %s", req.PeerId)
	return &pb.RegistrationResponse{
		Success: true,
		Message: "Peer registered successfully",
		PeerId:  req.PeerId,
	}, nil
}

// Heartbeat processes heartbeat from a peer
func (s *PeerRegistryServer) Heartbeat(ctx context.Context, req *pb.HeartbeatRequest) (*pb.HeartbeatResponse, error) {
	log.Printf("Heartbeat from peer: %s", req.PeerId)

	query := `
		UPDATE peers SET
			storage_free_gb = $1,
			is_online = true,
			last_seen_at = $2,
			last_heartbeat_at = $2
		WHERE peer_id = $3
	`

	result, err := s.db.ExecContext(ctx, query,
		req.AvailableCapacityBytes/1073741824,
		time.Now(),
		req.PeerId,
	)

	if err != nil {
		return &pb.HeartbeatResponse{
			Success: false,
			Message: fmt.Sprintf("Failed: %v", err),
		}, status.Errorf(codes.Internal, "database error: %v", err)
	}

	rows, _ := result.RowsAffected()
	if rows == 0 {
		return &pb.HeartbeatResponse{
			Success: false,
			Message: "Peer not found",
		}, status.Errorf(codes.NotFound, "peer not found")
	}

	return &pb.HeartbeatResponse{
		Success: true,
		Message: "Heartbeat processed",
	}, nil
}

// GetPeer retrieves peer information
func (s *PeerRegistryServer) GetPeer(ctx context.Context, req *pb.PeerRequest) (*pb.PeerInfo, error) {
	log.Printf("GetPeer called for: %s", req.PeerId)

	query := `
		SELECT peer_id, asn, region, storage_total_gb, storage_free_gb,
		       health_score, last_heartbeat_at, is_online
		FROM peers
		WHERE peer_id = $1
	`

	var info pb.PeerInfo
	var lastHeartbeat time.Time
	var online bool
	var totalGB, freeGB int64

	err := s.db.QueryRowContext(ctx, query, req.PeerId).Scan(
		&info.PeerId, &info.Asn, &info.Region,
		&totalGB, &freeGB,
		&info.HealthScore, &lastHeartbeat, &online,
	)

	if err == sql.ErrNoRows {
		return nil, status.Errorf(codes.NotFound, "peer not found")
	} else if err != nil {
		return nil, status.Errorf(codes.Internal, "database error: %v", err)
	}

	info.TotalCapacityBytes = totalGB * 1073741824
	info.AvailableCapacityBytes = freeGB * 1073741824
	info.LastHeartbeat = lastHeartbeat.Unix()
	
	if online {
		info.Status = "active"
	} else {
		info.Status = "inactive"
	}

	return &info, nil
}

// ListPeers retrieves list of peers
func (s *PeerRegistryServer) ListPeers(ctx context.Context, req *pb.ListPeersRequest) (*pb.PeerList, error) {
	log.Printf("ListPeers called, limit: %d, status: %s", req.Limit, req.Status)

	limit := req.Limit
	if limit == 0 || limit > 1000 {
		limit = 100
	}

	query := `
		SELECT peer_id, asn, region, storage_total_gb, storage_free_gb,
		       health_score, last_heartbeat_at, is_online
		FROM peers
		WHERE 1=1
	`

	if req.Status == "active" {
		query += " AND is_online = true"
	} else if req.Status == "inactive" {
		query += " AND is_online = false"
	}

	query += " ORDER BY last_heartbeat_at DESC LIMIT $1"

	rows, err := s.db.QueryContext(ctx, query, limit)
	if err != nil {
		return nil, status.Errorf(codes.Internal, "query failed: %v", err)
	}
	defer rows.Close()

	var peers []*pb.PeerInfo
	for rows.Next() {
		var info pb.PeerInfo
		var lastHeartbeat time.Time
		var online bool
		var totalGB, freeGB int64

		err := rows.Scan(
			&info.PeerId, &info.Asn, &info.Region,
			&totalGB, &freeGB,
			&info.HealthScore, &lastHeartbeat, &online,
		)
		if err != nil {
			continue
		}

		info.TotalCapacityBytes = totalGB * 1073741824
		info.AvailableCapacityBytes = freeGB * 1073741824
		info.LastHeartbeat = lastHeartbeat.Unix()
		
		if online {
			info.Status = "active"
		} else {
			info.Status = "inactive"
		}

		peers = append(peers, &info)
	}

	return &pb.PeerList{
		Peers: peers,
		Total: int32(len(peers)),
	}, nil
}

// Background job to mark inactive peers
func (s *PeerRegistryServer) runInactivePeerMarker() {
	ticker := time.NewTicker(1 * time.Hour)
	defer ticker.Stop()

	for range ticker.C {
		timeout := time.Now().Add(-time.Duration(s.config.HeartbeatTimeout) * time.Second)
		
		query := `
			UPDATE peers 
			SET is_online = false 
			WHERE last_heartbeat_at < $1 AND is_online = true
		`
		
		result, err := s.db.ExecContext(context.Background(), query, timeout)
		if err != nil {
			log.Printf("Error marking inactive peers: %v", err)
			continue
		}
		
		count, _ := result.RowsAffected()
		if count > 0 {
			log.Printf("Marked %d peers as inactive", count)
		}
	}
}

func main() {
	log.Println("Starting Peer Registry Service...")

	config := loadConfig()

	// Connect to database
	connStr := fmt.Sprintf("host=%s port=%s user=%s password=%s dbname=%s sslmode=disable",
		config.DBHost, config.DBPort, config.DBUser, config.DBPassword, config.DBName)

	db, err := sql.Open("postgres", connStr)
	if err != nil {
		log.Fatalf("Failed to connect to database: %v", err)
	}
	defer db.Close()

	if err := db.Ping(); err != nil {
		log.Fatalf("Failed to ping database: %v", err)
	}

	log.Println("Connected to database successfully")

	// Create server
	server := &PeerRegistryServer{
		db:     db,
		config: config,
	}

	// Start background jobs
	go server.runInactivePeerMarker()

	// Create gRPC server
	lis, err := net.Listen("tcp", ":"+config.GRPCPort)
	if err != nil {
		log.Fatalf("Failed to listen: %v", err)
	}

	grpcServer := grpc.NewServer()
	pb.RegisterPeerRegistryServer(grpcServer, server)
	reflection.Register(grpcServer)

	log.Printf("Peer Registry Service listening on port %s", config.GRPCPort)

	if err := grpcServer.Serve(lis); err != nil {
		log.Fatalf("Failed to serve: %v", err)
	}
}
